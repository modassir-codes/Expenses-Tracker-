# Server Port (fixed to 3000 in AI Studio environment)
PORT=3000

# MongoDB URI (Optional: If not provided, the app uses an integrated zero-config resilient file/memory store)
MONGODB_URI=

# JWT Authentication Secret Key
JWT_SECRET=auraspend_super_secure_jwt_secret_token_2026

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
